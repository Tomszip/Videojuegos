[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/menu.gd" id="1_script"]

[node name="menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_script")

[node name="Fondo" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.33, 0.55, 0.3, 1)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Titulo" type="RichTextLabel" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
bbcode_enabled = true
text = "[center][font_size=24][wave amp=30 freq=4][rainbow freq=0.5 sat=0.8 val=1]Cosecha[/rainbow][/wave][/font_size][/center]"
scroll_active = false

[node name="BotonNivel1" type="Button" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 12
text = "Nivel 1"

[node name="BotonNivel2" type="Button" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 12
text = "Nivel 2"

[node name="HBoxContainer" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
size_flags_horizontal = 4

[node name="LabelVolumen" type="Label" parent="MarginContainer/VBoxContainer/HBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Volumen"

[node name="SliderVolumen" type="HSlider" parent="MarginContainer/VBoxContainer/HBoxContainer"]
custom_minimum_size = Vector2(80, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
value = 100.0

[node name="BotonSalir" type="Button" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 12
text = "Salir"

[connection signal="pressed" from="MarginContainer/VBoxContainer/BotonNivel1" to="." method="_on_boton_nivel_1_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/BotonNivel2" to="." method="_on_boton_nivel_2_pressed"]
[connection signal="value_changed" from="MarginContainer/VBoxContainer/HBoxContainer/SliderVolumen" to="." method="_on_slider_volumen_value_changed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/BotonSalir" to="." method="_on_boton_salir_pressed"]
